{
  "name": "grauque",
  "productName": "Grauque",
  "version": "1.0.0",
  "description": "Ultra-fast Groq-powered AI assistant for macOS with double-tap Option popup and quiz generator.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "compile-helper": "clang -framework Cocoa -framework ApplicationServices src/main/native/opt-tap-listener.m -o bin/opt-tap-listener",
    "pack": "electron-builder --dir",
    "dist": "npm run compile-helper && electron-builder --mac dmg --x64"
  },
  "author": "pc <123230543+thepc101@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "prismjs": "^1.29.0"
  },
  "build": {
    "appId": "com.thepc101.grauque",
    "productName": "Grauque",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "bin/opt-tap-listener",
          "to": "bin/opt-tap-listener"
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Grauque Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}